{
  "extends": "./temp/tsconfig.cocos.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "db://assets/*": [
        "assets/*"
      ]
    }
  },
  "include": [
    "assets/**/*.ts"
  ]
}
