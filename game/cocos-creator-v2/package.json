    "integrity:write": "node ../../tools/generate-cocos-local-bundle-integrity.mjs --write",
    "test:bundles": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test ../../tests/assets/local-bundle-contract.test.mjs",
    "audit:audio": "node ../../tools/audit-v2-commercial-audio.mjs",
    "audit:bundle-sizes": "node ../../tools/audit-cocos-local-bundle-sizes.mjs",
    "test": "npm run validate && npm run test:bundles"
